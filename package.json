    "@yandex/smart-captcha": "2.9.0",
    "fabric": "^6.9.1",
    "jszip": "^3.10.2",
    "lenis": "^1.3.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
